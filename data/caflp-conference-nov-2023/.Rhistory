waste %>%
ggplot(aes(x = "", y = percent, fill = type)) +
geom_col(color = "black") +
scale_fill_brewer(palette="Blues") +
coord_polar(theta = "y") +
labs(
title = "Combined Residential and ICI Waste, Nova Scotia)",
y = "",
)
